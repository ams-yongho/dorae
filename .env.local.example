DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/dorae?pgbouncer=true
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/dorae

SLACK_BOT_TOKEN=xoxb-...
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# 관리자는 DB의 AdminUser 테이블에서 관리됩니다 (/admins UI).
# 이 환경변수는 부트스트랩 및 비상 복구용 fallback입니다.
# DB가 비어있거나 락아웃 상황에서 이 이메일은 항상 로그인 가능합니다.
# 운영 안정화 후에는 1명 정도만 유지하는 것을 권장합니다.
ADMIN_EMAILS=admin@yourcompany.com
CRON_SECRET=
NOTIFICATION_FALLBACK_CHANNEL=
